# =============================================
# Variables de entorno — APP-Concurso Backend
# =============================================
# Copiar este archivo como .env y completar los valores

# Servidor
PORT=3001
NODE_ENV=development

# Base de datos — MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=app_concurso

# Sequelize — sincronización automática (solo desarrollo)
# true  → crea/modifica tablas al iniciar (no usar en producción)
# false → asume que las tablas ya existen
DB_SYNC=true

# JWT (para autenticación futura)
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=7d

# CORS — origen permitido del frontend
CORS_ORIGIN=http://localhost:3000
